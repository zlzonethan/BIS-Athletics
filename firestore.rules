rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    function isAllowedAdminEmail() {
      return request.auth.token.email != null &&
        (
          request.auth.token.email == 'iamsunwo@gmail.com' ||
          request.auth.token.email == 'tcassell@bisce.net' ||
          request.auth.token.email == 'athletics@bisce.net' ||
          request.auth.token.email == '30ekim@bisce.net' ||
          request.auth.token.email == '30epark@bisce.net'
        );
    }

    function isAdmin() {
      return request.auth != null && isAllowedAdminEmail();
    }

    function canWriteTeamPage() {
      return isAdmin() &&
        request.resource.data.keys().hasOnly(['tabs', 'updatedAt', 'updatedBy']) &&
        request.resource.data.tabs is list &&
        (!request.resource.data.keys().hasAny(['updatedAt']) || request.resource.data.updatedAt is string) &&
        (!request.resource.data.keys().hasAny(['updatedBy']) || request.resource.data.updatedBy is string);
    }

    function canWriteSiteContent() {
      return isAdmin() &&
        request.resource.data.keys().hasOnly(['fields', 'rosters', 'updatedAt', 'updatedBy']) &&
        request.resource.data.fields is map &&
        (!request.resource.data.keys().hasAny(['rosters']) || request.resource.data.rosters is map) &&
        (!request.resource.data.keys().hasAny(['updatedAt']) || request.resource.data.updatedAt is string) &&
        (!request.resource.data.keys().hasAny(['updatedBy']) || request.resource.data.updatedBy is string);
    }

    function canWriteMatchFormation() {
      return isAdmin() &&
        request.resource.data.keys().hasOnly(['sport', 'home', 'away', 'updatedAt', 'updatedBy']) &&
        request.resource.data.sport is string &&
        request.resource.data.home is list &&
        request.resource.data.away is list &&
        (!request.resource.data.keys().hasAny(['updatedAt']) || request.resource.data.updatedAt is string) &&
        (!request.resource.data.keys().hasAny(['updatedBy']) || request.resource.data.updatedBy is string);
    }

    function isValidVoteDoc() {
      return request.resource.data.keys().hasOnly(['home', 'draw', 'away']) &&
        (!request.resource.data.keys().hasAny(['home']) || request.resource.data.home is int) &&
        (!request.resource.data.keys().hasAny(['draw']) || request.resource.data.draw is int) &&
        (!request.resource.data.keys().hasAny(['away']) || request.resource.data.away is int) &&
        (!request.resource.data.keys().hasAny(['home']) || request.resource.data.home >= 0) &&
        (!request.resource.data.keys().hasAny(['draw']) || request.resource.data.draw >= 0) &&
        (!request.resource.data.keys().hasAny(['away']) || request.resource.data.away >= 0);
    }

    function voteHome(data) {
      return data.keys().hasAny(['home']) ? data.home : 0;
    }
    function voteDraw(data) {
      return data.keys().hasAny(['draw']) ? data.draw : 0;
    }
    function voteAway(data) {
      return data.keys().hasAny(['away']) ? data.away : 0;
    }

    function isValidVoteCreate() {
      return isValidVoteDoc() &&
        (voteHome(request.resource.data) + voteDraw(request.resource.data) + voteAway(request.resource.data)) == 1;
    }

    function isValidVoteUpdate() {
      return isValidVoteDoc() &&
        resource.data.keys().hasOnly(['home', 'draw', 'away']) &&
        (voteHome(request.resource.data) >= voteHome(resource.data)) &&
        (voteDraw(request.resource.data) >= voteDraw(resource.data)) &&
        (voteAway(request.resource.data) >= voteAway(resource.data)) &&
        (
          (voteHome(request.resource.data) - voteHome(resource.data)) +
          (voteDraw(request.resource.data) - voteDraw(resource.data)) +
          (voteAway(request.resource.data) - voteAway(resource.data))
        ) == 1;
    }

    match /votes/{matchId} {
      allow read: if true;
      // Public voting is allowed, but only +1 increments.
      allow create: if isValidVoteCreate();
      allow update: if isValidVoteUpdate();
      allow delete: if false;
    }

    match /finishedMatches/{matchId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /customMatches/{matchId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /teamPageContent/{docId} {
      allow read: if true;
      allow write: if canWriteTeamPage();
    }

    match /siteContent/{docId} {
      allow read: if true;
      allow write: if canWriteSiteContent();
    }

    match /matchFormations/{docId} {
      allow read: if true;
      allow write: if canWriteMatchFormation();
    }

    match /liveScores/{matchId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /siteEditorPages/{docId} {
      allow read: if true;
      allow create, update: if canWriteSiteContent();
      allow delete: if isAdmin();
    }

    match /deletedMatches/{matchId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
